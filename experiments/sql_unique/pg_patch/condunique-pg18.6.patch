+/*-------------------------------------------------------------------------
+ *
+ * condunique.c
+ *	  Uniqueness proofs from conditional (partial) unique indexes.
+ *
+ * A unique index with predicate C on key columns K states C : U(K): no two
+ * rows that satisfy C agree on K with all key values non-null.  With NULLS
+ * NOT DISTINCT it states C : U=(K), where a null agrees with a null.  Given
+ * the unique indexes of a relation (partial or not), its NOT NULL columns
+ * and the restriction clauses Q that the query applies to it, we decide
+ * whether Q : U(K) (or Q : U=(K)) follows for a set K of columns.  The
+ * planner can then treat the rows the query reads as unique on K, which the
+ * stock code only does for unique indexes without a predicate.
+ *
+ * Conditions are sets of templates (disjunctive normal form); a template
+ * restricts each column to any value, IS NULL, a set of constants (=, IN)
+ * or the complement of one (<>, NOT IN, IS NOT NULL).  The implication fails
+ * iff some two-row table satisfies every premise and violates the goal.
+ * Each column of such a pair is in one of finitely many states: each row
+ * holds null, one of the constants that the conditions mention for the
+ * column, or a value outside them, and two outside values agree or not.
+ * Whether the pair satisfies the premises is monotone in a few features of
+ * the column states (a row fails a template on the column; the rows
+ * disagree on a key column), so we keep only states with maximal feature
+ * sets and search over the columns with an optimistic bound.  The problem is
+ * coNP-complete in general; the search gives up, answering "not proven",
+ * after CU_MAX_NODES nodes.
+ *
+ * Validated CHECK constraints are facts about every row, so they narrow the
+ * goal's scope like restriction clauses do.  A row passes CHECK c when c is
+ * true or null, so the scope is narrowed by c or "some column that c
+ * compares is null"; columns c only tests with IS [NOT] NULL or IS TRUE/FALSE
+ * cannot make it null.
+ *
+ * Soundness only needs that a clause we cannot translate is dropped from
+ * the goal (a weaker condition makes a stronger goal) and makes an index
+ * unusable as a premise, and that every equality involved is the equality
+ * operator of the default btree opclass of the column's type under a
+ * deterministic collation (an index may use another opclass with the same
+ * equality, such as text_pattern_ops), so that "agree" and "equals a
+ * constant" mean the same thing everywhere.
+ *
+ * src/backend/optimizer/util/condunique.c
+ *
+ *-------------------------------------------------------------------------
+ */
+#include "postgres.h"
+
+#include "access/stratnum.h"
+#include "access/table.h"
+#include "catalog/pg_am_d.h"
+#include "catalog/pg_class_d.h"
+#include "catalog/pg_type_d.h"
+#include "commands/defrem.h"
+#include "nodes/makefuncs.h"
+#include "nodes/nodeFuncs.h"
+#include "optimizer/condunique.h"
+#include "optimizer/optimizer.h"
+#include "optimizer/prep.h"
+#include "optimizer/tlist.h"
+#include "parser/parsetree.h"
+#include "port/pg_bitutils.h"
+#include "rewrite/rewriteManip.h"
+#include "utils/array.h"
+#include "utils/lsyscache.h"
+#include "utils/memutils.h"
+#include "utils/rel.h"
